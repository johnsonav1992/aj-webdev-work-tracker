{
  "name": "aj-webdev-work-tracker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development node --env-file-if-exists=.env --watch --import remix/node-tsx server.ts",
    "hmr": "NODE_ENV=development node --env-file-if-exists=.env hmr.ts",
    "start": "NODE_ENV=production node --env-file-if-exists=.env --import remix/node-tsx server.ts",
    "test": "NODE_ENV=test remix test && node --test lint-plugins/oxlint-plugin.test.js",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "npm run format:check && npm run lint",
    "typecheck": "tsc --noEmit",
    "db:status": "remix db status",
    "db:migrate": "remix db migrate",
    "db:rollback": "remix db rollback",
    "db:import-timesheet": "node --env-file-if-exists=.env --import remix/node-tsx scripts/import-timesheet.ts"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "remix": "^3.0.0-rc.3"
  },
  "devDependencies": {
    "@types/node": "latest",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "typescript": "latest"
  },
  "engines": {
    "node": ">=24.12.0"
  }
}
