{
  "name": "aj-webdev-work-tracker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development node --watch --import remix/node-tsx server.ts",
    "hmr": "NODE_ENV=development node hmr.ts",
    "start": "NODE_ENV=production node --import remix/node-tsx server.ts",
    "test": "NODE_ENV=test remix test && node --test scripts/oxlint-plugin.test.js",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "npm run format:check && npm run lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "remix": "^3.0.0-rc.3"
  },
  "devDependencies": {
    "@types/node": "latest",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "typescript": "latest"
  },
  "engines": {
    "node": ">=24.3.0"
  }
}
