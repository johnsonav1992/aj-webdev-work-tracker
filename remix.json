{
  "$schema": "./node_modules/remix/schema/remix.json",
  "db": {
    "adapter": {
      "type": "sqlite",
      "filename": { "env": "DATABASE_URL", "default": "./db/work-tracker.sqlite" },
      "foreignKeys": true,
      "busyTimeout": 5000
    },
    "migrations": {
      "directory": "./app/db/migrations",
      "journalTable": "data_table_migrations"
    }
  }
}
