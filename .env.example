# Required for production. In local development, a development-only fallback is used if unset.
SESSION_SECRET=replace-with-a-long-random-secret

# Set this to the externally reachable origin in production.
APP_ORIGIN=http://localhost:44100

# Configure both values to enable Google OAuth. Register APP_ORIGIN/auth/google/callback with Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional local SQLite filename. The default is ./db/work-tracker.sqlite.
DATABASE_URL=./db/work-tracker.sqlite
